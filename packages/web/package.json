{
  "name": "@elysium/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "start": "bun .output/server/index.mjs",
    "test": "vitest run --config vitest.config.ts",
    "lint": "tsc --noEmit && biome check ./src",
    "format": "biome check ./src --unsafe --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@elysium/backend": "workspace:*",
    "@elysiajs/eden": "^1.4.9",
    "@fontsource-variable/figtree": "^5.2.10",
    "@hugeicons/core-free-icons": "^3.1.0",
    "@hugeicons/react": "^1.1.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "^1.27.5",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.54",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.3.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "5.103.1",
    "@tanstack/react-router-devtools": "1.167.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "^3.0.260311-beta",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.14",
    "vitest": "^4.1.11"
  }
}
