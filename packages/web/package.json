{
  "name": "@elysium/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "build": "bun --bun vite build && tsc --noEmit",
    "preview": "bun --bun vite preview",
    "start": "bun .output/server/index.mjs",
    "test": "vitest run --config vitest.config.ts",
    "lint": "tsc --noEmit && biome check ./src",
    "format": "biome check ./src --unsafe --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@elysium/backend": "workspace:*",
    "@elysium/contracts": "workspace:*",
    "@elysiajs/eden": "^1.4.9",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "nitro": "^3.0.261103-rc",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.1.0"
  }
}
