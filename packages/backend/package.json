{
  "name": "@elysium/backend",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test --preload ./test/setup.ts",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "lint": "tsc && biome check ./src",
    "format": "biome check ./src --unsafe --write",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "1.4.16",
    "@elysium/contracts": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-logs": "^3.1.0",
    "@sinclair/typebox": "0.34.52",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "elysia": "^1.4.30",
    "file-type": "22.2.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.11"
  },
  "module": "src/index.js"
}
