{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "files": {
    "includes": [
      "**",
      "!**/routeTree.gen.ts",
      "!**/node_modules",
      "!**/.git",
      "!**/.output",
      "!**/.nitro",
      "!**/dist",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/drizzle/meta",
      "!.omc"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  },
  "tailwind": {
    "attributes": ["className"],
    "mergeFunctions": ["cn"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "error",
          "fix": "safe"
        }
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
