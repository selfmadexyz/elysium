{
  "name": "elysium",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "baseline-browser-mapping": "2.11.24",
    "browserslist": "4.29.0",
    "defu": "6.1.7",
    "esbuild": "0.28.2",
    "file-type": "22.1.0",
    "nanoid": "5.1.16",
    "picomatch": "4.0.7",
    "postcss": "8.5.28",
    "vite": "8.3.0"
  },
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "bun --env-file=packages/backend/.env run --cwd packages/web dev",
    "dev:backend": "bun run --cwd packages/backend dev",
    "build": "bun run build:backend && bun run build:web",
    "build:web": "bun run --cwd packages/web build",
    "build:backend": "bun build packages/backend/src/index.ts --target=bun --outdir=packages/backend/dist",
    "typecheck": "bun run typecheck:contracts && bun run typecheck:backend && bun run typecheck:web",
    "typecheck:contracts": "tsc -p packages/contracts/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p packages/web/tsconfig.json --noEmit",
    "typecheck:backend": "tsc -p packages/backend/tsconfig.json --noEmit",
    "lint": "bun run typecheck && biome check packages/backend/src packages/backend/test packages/contracts/src packages/web/src",
    "format": "biome check packages/backend/src packages/backend/test packages/contracts/src packages/web/src --write",
    "test": "bun run --sequential --filter '*' test",
    "db:migrate": "bun run --cwd packages/backend db:migrate",
    "db:generate": "bun run --cwd packages/backend db:generate",
    "audit": "bun audit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  }
}
